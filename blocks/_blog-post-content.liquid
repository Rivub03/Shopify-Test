

<div class="blog-post-content rte">
  <rte-formatter>
    <!--{{ article.content}} replacing this with Inline Media Shortcodes so that article doesn't render twice-->
    {% render 'render-inline-media', content: article.content, article: article %}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: var(--normal-content-width);
    margin: 0 auto;
    background: #D9D9D9;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 15px 51px;
    gap: 25px;
    isolation: isolate;

    border: 15px solid #000000;
    box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
    border-radius: 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [],
  "presets": [
    {
      "name": "t:names.content"
    }
  ]
}
{% endschema %}
