{%- comment -%}
  Renders inline media based on shortcodes in article content
  Usage: {% render 'render-inline-media', content: article.content, article: article %}
  
  Supported shortcodes:
  - [media-image-1] or [media-image-1 caption="Your caption here"]
  - [media-audio-1] or [media-audio-1 caption="Your caption here"]
  - [media-video-1] or [media-video-1 caption="Your caption here"]
  - [media-link-1] or [media-link-1 caption="Your caption here"]
{%- endcomment -%}

{%- liquid
  # Start with the original content
  assign processed_content = content
  
  # Get all media from metafields
  assign media_images = article.metafields.custom.media_image.value
  assign media_audios = article.metafields.custom.media_audio.value
  assign media_videos = article.metafields.custom.media_video.value
  assign media_video_links = article.metafields.custom.media_video_link.value
-%}

{%- comment -%} Process Images {%- endcomment -%}
{%- if media_images -%}
  {%- for image in media_images -%}
    {%- liquid
      assign index = forloop.index
      assign shortcode_simple = '[media-image-' | append: index | append: ']'
      assign shortcode_pattern = '[media-image-' | append: index | append: ' '
    -%}
    
    {%- comment -%} Check if content contains this shortcode (simple or with caption) {%- endcomment -%}
    {%- if processed_content contains shortcode_simple or processed_content contains shortcode_pattern -%}
      {%- comment -%} Extract caption if present {%- endcomment -%}
      {%- assign caption = '' -%}
      {%- assign shortcode_to_replace = shortcode_simple -%}
      
      {%- if processed_content contains shortcode_pattern -%}
        {%- assign shortcode_start = processed_content | split: shortcode_pattern | first | size -%}
        {%- assign after_shortcode = processed_content | slice: shortcode_start -%}
        {%- assign shortcode_end_pos = after_shortcode | split: ']' | first | size | plus: 1 -%}
        {%- assign full_shortcode = after_shortcode | slice: 0, shortcode_end_pos -%}
        {%- assign shortcode_to_replace = full_shortcode -%}
        
        {%- if full_shortcode contains 'caption="' -%}
          {%- assign caption_start = full_shortcode | split: 'caption="' | last -%}
          {%- assign caption = caption_start | split: '"' | first -%}
        {%- endif -%}
      {%- endif -%}
      
      {%- capture image_html -%}
        <figure class="inline-media inline-media--image">
          <img
            src="{{ image | image_url: width: 1200 }}"
            srcset="
              {{ image | image_url: width: 400 }} 400w,
              {{ image | image_url: width: 800 }} 800w,
              {{ image | image_url: width: 1200 }} 1200w,
              {{ image | image_url: width: 1600 }} 1600w
            "
            sizes="(min-width: 750px) calc(100vw - 10rem), calc(100vw - 3rem)"
            alt="{{ caption | default: image.alt | default: article.title }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
          {%- if caption != blank -%}
            <figcaption>{{ caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endcapture -%}
      
      {%- assign processed_content = processed_content | replace_first: shortcode_to_replace, image_html -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Process Audio {%- endcomment -%}
{%- if media_audios -%}
  {%- for audio in media_audios -%}
    {%- liquid
      assign index = forloop.index
      assign shortcode_simple = '[media-audio-' | append: index | append: ']'
      assign shortcode_pattern = '[media-audio-' | append: index | append: ' '
    -%}
    
    {%- if processed_content contains shortcode_simple or processed_content contains shortcode_pattern -%}
      {%- assign caption = '' -%}
      {%- assign shortcode_to_replace = shortcode_simple -%}
      
      {%- if processed_content contains shortcode_pattern -%}
        {%- assign shortcode_start = processed_content | split: shortcode_pattern | first | size -%}
        {%- assign after_shortcode = processed_content | slice: shortcode_start -%}
        {%- assign shortcode_end_pos = after_shortcode | split: ']' | first | size | plus: 1 -%}
        {%- assign full_shortcode = after_shortcode | slice: 0, shortcode_end_pos -%}
        {%- assign shortcode_to_replace = full_shortcode -%}
        
        {%- if full_shortcode contains 'caption="' -%}
          {%- assign caption_start = full_shortcode | split: 'caption="' | last -%}
          {%- assign caption = caption_start | split: '"' | first -%}
        {%- endif -%}
      {%- endif -%}
      
      {%- capture audio_html -%}
        <figure class="inline-media inline-media--audio">
          <audio controls preload="metadata">
            <source src="{{ audio.url }}" type="{{ audio.mime_type | default: 'audio/mpeg' }}">
            Your browser does not support the audio element.
          </audio>
          {%- if caption != blank -%}
            <figcaption>{{ caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endcapture -%}
      
      {%- assign processed_content = processed_content | replace_first: shortcode_to_replace, audio_html -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Process Uploaded Videos {%- endcomment -%}
{%- if media_videos -%}
  {%- for video in media_videos -%}
    {%- liquid
      assign index = forloop.index
      assign shortcode_simple = '[media-video-' | append: index | append: ']'
      assign shortcode_pattern = '[media-video-' | append: index | append: ' '
    -%}
    
    {%- if processed_content contains shortcode_simple or processed_content contains shortcode_pattern -%}
      {%- assign caption = '' -%}
      {%- assign shortcode_to_replace = shortcode_simple -%}
      
      {%- if processed_content contains shortcode_pattern -%}
        {%- assign shortcode_start = processed_content | split: shortcode_pattern | first | size -%}
        {%- assign after_shortcode = processed_content | slice: shortcode_start -%}
        {%- assign shortcode_end_pos = after_shortcode | split: ']' | first | size | plus: 1 -%}
        {%- assign full_shortcode = after_shortcode | slice: 0, shortcode_end_pos -%}
        {%- assign shortcode_to_replace = full_shortcode -%}
        
        {%- if full_shortcode contains 'caption="' -%}
          {%- assign caption_start = full_shortcode | split: 'caption="' | last -%}
          {%- assign caption = caption_start | split: '"' | first -%}
        {%- endif -%}
      {%- endif -%}
      
      {%- capture video_html -%}
        <figure class="inline-media inline-media--video">
          {{ video | video_tag: controls: true, preload: "metadata" }}
          {%- if caption != blank -%}
            <figcaption>{{ caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endcapture -%}
      
      {%- assign processed_content = processed_content | replace_first: shortcode_to_replace, video_html -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Process Video Links (YouTube/Vimeo/Instagram/TikTok) {%- endcomment -%}
{%- if media_video_links -%}
  {%- for link in media_video_links -%}
    {%- liquid
      assign index = forloop.index
      assign shortcode_simple = '[media-link-' | append: index | append: ']'
      assign shortcode_pattern = '[media-link-' | append: index | append: ' '
    -%}
    
    {%- if processed_content contains shortcode_simple or processed_content contains shortcode_pattern -%}
      {%- assign caption = '' -%}
      {%- assign shortcode_to_replace = shortcode_simple -%}
      
      {%- if processed_content contains shortcode_pattern -%}
        {%- assign shortcode_start = processed_content | split: shortcode_pattern | first | size -%}
        {%- assign after_shortcode = processed_content | slice: shortcode_start -%}
        {%- assign shortcode_end_pos = after_shortcode | split: ']' | first | size | plus: 1 -%}
        {%- assign full_shortcode = after_shortcode | slice: 0, shortcode_end_pos -%}
        {%- assign shortcode_to_replace = full_shortcode -%}
        
        {%- if full_shortcode contains 'caption="' -%}
          {%- assign caption_start = full_shortcode | split: 'caption="' | last -%}
          {%- assign caption = caption_start | split: '"' | first -%}
        {%- endif -%}
      {%- endif -%}
      
      {%- comment -%} Determine platform and generate embed URL {%- endcomment -%}
      {%- assign embed_link = '' -%}
      {%- assign platform = 'unknown' -%}
      {%- assign aspect_ratio = '16 / 9' -%}
      
      {%- if link contains 'youtube.com' or link contains 'youtu.be' -%}
        {%- assign platform = 'youtube' -%}
        {%- assign embed_link = link | replace: 'watch?v=', 'embed/' | replace: 'youtu.be/', 'youtube.com/embed/' | replace: '&list', '?list' -%}
        {%- if link contains '/shorts/' -%}
          {%- assign embed_link = link | replace: '/shorts/', '/embed/' -%}
          {%- assign aspect_ratio = '9 / 16' -%}
        {%- endif -%}
      {%- elsif link contains 'instagram.com' -%}
        {%- assign platform = 'instagram' -%}
        {%- assign aspect_ratio = '9 / 16' -%}
        {%- comment -%} Instagram Reels: Extract the post ID {%- endcomment -%}
        {%- if link contains '/reel/' -%}
          {%- assign reel_id = link | split: '/reel/' | last | split: '/' | first | split: '?' | first -%}
          {%- assign embed_link = 'https://www.instagram.com/p/' | append: reel_id | append: '/embed' -%}
        {%- elsif link contains '/p/' -%}
          {%- assign post_id = link | split: '/p/' | last | split: '/' | first | split: '?' | first -%}
          {%- assign embed_link = 'https://www.instagram.com/p/' | append: post_id | append: '/embed' -%}
        {%- endif -%}
      {%- elsif link contains 'tiktok.com' -%}
        {%- assign platform = 'tiktok' -%}
        {%- assign aspect_ratio = '9 / 16' -%}
        {%- comment -%} TikTok: Extract video ID {%- endcomment -%}
        {%- if link contains '/video/' -%}
          {%- assign video_id = link | split: '/video/' | last | split: '?' | first -%}
          {%- assign embed_link = 'https://www.tiktok.com/embed/v2/' | append: video_id -%}
        {%- endif -%}
      {%- elsif link contains 'vimeo.com' -%}
        {%- assign platform = 'vimeo' -%}
        {%- assign video_id = link | split: 'vimeo.com/' | last | split: '?' | first -%}
        {%- assign embed_link = 'https://player.vimeo.com/video/' | append: video_id -%}
      {%- else -%}
        {%- assign embed_link = link -%}
      {%- endif -%}
      
      {%- capture link_html -%}
        <figure class="inline-media inline-media--embed inline-media--{{ platform }}">
          <div class="inline-media__embed-container" style="aspect-ratio: {{ aspect_ratio }};">
            <iframe
              src="{{ embed_link }}"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
              {%- if platform == 'instagram' %} scrolling="no"{%- endif -%}
            ></iframe>
          </div>
          {%- if caption != blank -%}
            <figcaption>{{ caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endcapture -%}
      
      {%- assign processed_content = processed_content | replace_first: shortcode_to_replace, link_html -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Output the processed content {%- endcomment -%}
{{ processed_content }}