

<div class="blog-post-content rte">
  <rte-formatter>
    <!--{{ article.content}} replacing this with Inline Media Shortcodes so that article doesn't render twice-->
    {% render 'render-inline-media', content: article.content, article: article %}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: var(--normal-content-width);
    margin: 0 auto;
    background: #D9D9D9;
    position: relative;
    padding: var(--padding-lg);
    border-radius: var(--style-border-radius-lg, 8px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [],
  "presets": [
    {
      "name": "t:names.content"
    }
  ]
}
{% endschema %}
